# Copy this file to .env and fill it in. Docker Compose reads .env automatically,
# and .gitignore keeps it out of Git, so your secrets stay on your computer.

# Signs the login tokens: a long random value, at least 32 characters.
JWT_SECRET=

# The database. These match the backend's defaults in application.yml, so the dev setup
# (docker compose up -d db, then mvnw spring-boot:run) keeps working. Only change them
# before the database is first created: Postgres sets the password once, when it starts empty.
POSTGRES_DB=expenses
POSTGRES_USER=app
POSTGRES_PASSWORD=secret